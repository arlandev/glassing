# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.

# Supabase: project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude: console.anthropic.com > API keys
ANTHROPIC_API_KEY=

# JSearch: rapidapi.com > subscribe to JSearch > your app key
RAPIDAPI_KEY=

# Resend: resend.com > API keys. onboarding@resend.dev only delivers to your own Resend account email;
# verify a domain to email real users.
RESEND_API_KEY=
EMAIL_FROM=glassing <onboarding@resend.dev>

# Generate with: openssl rand -hex 32. The hourly cron sends it as a Bearer token.
CRON_SECRET=

# Shared password for the invite-only gate (/gate). Every page needs it first; if unset, nobody gets in.
SITE_PASSWORD=

# Where to email the owner when the Claude API spend limit is hit (at most every 12h).
ALERT_EMAIL=

# Public URL of the app, used for the link in emails.
APP_URL=http://localhost:3000
